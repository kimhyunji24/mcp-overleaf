# Copy to .env (git-ignored) and fill in. Used by `npm run smoke`.

# Overleaf → Account Settings → Git Integration → Generate token (paid/institutional plans).
OVERLEAF_GIT_TOKEN=

# Optional, OFF by default. Web mode uses Overleaf's internal web endpoints, which are not a
# publicly supported interface and may violate Overleaf's Acceptable Use Policy (your account
# could be suspended). Set to 1 only if you accept that risk, and provide the session cookie:
# overleaf.com → DevTools → Application → Cookies → value of overleaf_session2
OVERLEAF_ENABLE_WEB=
OVERLEAF_SESSION_COOKIE=

# A THROWAWAY test project (the smoke test writes sections/mcp-smoke-test.tex into it)
OVERLEAF_PROJECT_ID=
