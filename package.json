{
  "name": "mcp-overleaf",
  "version": "0.1.2",
  "description": "Unofficial MCP server for Overleaf: read, edit and write LaTeX projects (in Markdown too) from Claude, Cursor and other MCP clients. Not affiliated with Overleaf.",
  "author": "Hyunji KIM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimhyunji24/mcp-overleaf.git"
  },
  "homepage": "https://github.com/kimhyunji24/mcp-overleaf#readme",
  "bugs": {
    "url": "https://github.com/kimhyunji24/mcp-overleaf/issues"
  },
  "type": "module",
  "bin": {
    "mcp-overleaf": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "tsc && node --test dist/latex.test.js dist/markdown.test.js dist/config.test.js dist/i18n.test.js dist/git.test.js",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "overleaf",
    "latex",
    "claude"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "fflate": "^0.8.2",
    "jose": "^6.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
