{
  "name": "overleaf-mcp",
  "version": "0.1.0",
  "description": "MCP server for Overleaf: read, edit, compile and review LaTeX projects from Claude, Cursor and other MCP clients",
  "type": "module",
  "bin": {
    "overleaf-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node --test dist/latex.test.js dist/markdown.test.js",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "overleaf",
    "latex",
    "claude"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "fflate": "^0.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
